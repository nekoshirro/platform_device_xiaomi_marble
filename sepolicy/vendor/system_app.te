allow system_app hal_mlipay_hwservice:hwservice_manager find;

binder_call(system_app, hal_mlipay_default)

allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_thermal:{ file lnk_file } rw_file_perms;

# Charge Boost writes sport_mode and pd_verifed under /sys/class/qcom-battery,
# which device/qcom/sepolicy_vndr labels vendor_sysfs_battery_supply
allow system_app vendor_sysfs_battery_supply:dir search;
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;

# Performance Monitor reads GPU and FPS sysfs nodes
allow system_app vendor_sysfs_kgsl_gpuclk:file r_file_perms;
allow system_app vendor_sysfs_graphics:dir search;
allow system_app vendor_sysfs_graphics:file rw_file_perms;
allow system_app vendor_sysfs_kgsl:dir search;
allow system_app vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;
